## Frontend environment variables (Vite)
#
# Local dev:
# - Leave this unset and Vite will proxy `/api` to the backend (see `vite.config.js`)
#
# Production (Azure Static Web Apps):
# - Set this to your App Service base URL (no trailing slash), e.g.
#   VITE_API_BASE_URL=https://<your-app>.azurewebsites.net/api
#
VITE_API_BASE_URL=

